  (text "ESP32-WROOM-32D board. 3.3 V comes from the ESP32 regulator, a separate supply from the pack. Pack positive is not connected." (exclude_from_sim no) (at 15 18 0)
    (effects (font (size 1.6 1.6)) (justify left top))
    (uuid "fb13011a-af5f-437b-9330-4ca7f899f010"))
  (text "U2 address is 0x70: A2, A1 and A0 are tied to GND. RESET is tied to 3.3 V." (exclude_from_sim no) (at 15 200 0)
    (effects (font (size 1.5 1.5)) (justify left top))
    (uuid "2355a933-c6c2-4c9f-9d12-b738681ebfd6"))
  (text "Channel 3 only. SD3 (TCA9548A pin 10) goes to 4SU0016 pin 128, SDA. SC3 (pin 11) goes to 4SU0016 pin 127, SCL." (exclude_from_sim no) (at 15 206 0)
    (effects (font (size 1.5 1.5)) (justify left top))
    (uuid "e4db6759-582e-44d2-af10-4133ecd55a7d"))
  (text "R1 and R2 are 3.3 kOhm from the ESP32 3.3 V rail to SD3 and SC3. Channels 0-2 and 4-7 are not part of this adapter." (exclude_from_sim no) (at 15 212 0)
    (effects (font (size 1.5 1.5)) (justify left top))
    (uuid "78624cff-15a8-4617-8b84-0f57267de888"))
  (text "The GND symbols are one net: ESP32 ground and 4SU0016 ground." (exclude_from_sim no) (at 15 218 0)
    (effects (font (size 1.5 1.5)) (justify left top))
    (uuid "b676bed1-7411-4106-89f4-fdff4cc59926"))
  (text "4SU0016 ground" (exclude_from_sim no) (at 266.0 152.46 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "08bbc32d-835c-474f-908b-8e005ecdde16"))
