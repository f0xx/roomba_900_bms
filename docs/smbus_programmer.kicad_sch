		(uuid "38a7179d-bdc5-46c7-b806-8e61d68286c5")
	)
	(text "plate 28"
		(exclude_from_sim no)
		(at 336 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3b133c61-0218-4884-9c2f-0317d2979bff")
	)
	(text "GPIO17 (module pin 28) drives pin 7 TOOL0, PCB plate 29. R3 is 3.3 kOhm from TOOL0 to 3.3 V."
		(exclude_from_sim no)
		(at 12.7 273.2 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "49b3e06e-d68e-4da9-b6e9-54ff3522c5f8")
	)
	(text "GPIO26 (module pin 11) reads pin 6 TxD0. R4 is 3.3 kOhm from pin 6 to 3.3 V."
		(exclude_from_sim no)
		(at 12.7 268 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "8baed13c-e311-4e5e-98d5-530d83d2aaf9")
	)
	(text "Channel 3 only. SD3 (TCA9548A pin 10) goes to 4SU0016 pin 128 SDA. SC3 (pin 11) goes to pin 127 SCL."
		(exclude_from_sim no)
		(at 12.7 252.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "8c381c50-a0aa-45b1-b617-333bfd467d65")
	)
	(text "Programming UART, 115200 8N2. GPIO25 (module pin 10) drives RAJ240045 pin 5 RxD0, direct."
		(exclude_from_sim no)
		(at 12.7 262.8 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
