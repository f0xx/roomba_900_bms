	(text "GND symbols are one net: ESP32 ground and 4SU0016 ground."
		(exclude_from_sim no)
		(at 12.7 283.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "159c46cc-63fa-4881-8a4e-50e66aa161dd")
	)
	(text "GPIO16 (module pin 27) drives pin 8 RESET, PCB plate 28, direct, no pull-up."
		(exclude_from_sim no)
		(at 12.7 278.4 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "2c2f67d2-1bbd-4732-8bd5-0ec6bb58b77e")
	)
	(text "R1 and R2 are 3.3 kOhm from 3.3 V to SD3 and SC3."
		(exclude_from_sim no)
		(at 12.7 257.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
